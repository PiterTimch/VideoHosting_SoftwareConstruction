{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
  },
  "ImagesDir": "images",
  "ImageSizes": [
    50,
    100,
    200,
    400,
    800,
    1200
  ],
  "ImageFormats": [ "webp" ],
  "VideosDir": "videos",
  "VideoSizes": [
    240,
    360,
    480,
    720,
    1080
  ],
  "VideoProcessing": {
    "FfmpegThreads": 2,
    "ProgressUpdateIntervalSeconds": 3,
    "MinProgressPercentDelta": 2,
    "HangfireWorkerCount": 1
  },
  "Jwt": {
    "Key": "xN2uVYzTc4HhJg4sEXR1PfVnNDrQZlTwPjWQZ+vSlA8="
  },
  "VideoAccessToken": {
    "ExpiryMinutes": 60
  },
  "GoogleUserInfo": "https://www.googleapis.com/oauth2/v2/userinfo",
  "ClientUrl": "http://localhost:5173"
}
